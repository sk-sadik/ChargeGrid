# Application
APP_NAME="Charge Grid"
APP_ENV="development"
DEBUG=true

# Database - MongoDB (local development defaults - replace with Atlas URI in production)
MONGO_URI=mongodb://localhost:27017
# Production example (never commit the real URI):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=chargegrid

# JWT - generate a strong random secret for production (openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allocator
ALLOCATOR_INTERVAL_SECONDS=60
SITE_POWER_CAP_KW=50

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# CORS - JSON array of allowed origins (no "*" with credentials)
# Local frontend dev server:
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Convenience single-origin alternative (e.g. your Vercel frontend URL in production):
# FRONTEND_URL=https://chargegrid.vercel.app